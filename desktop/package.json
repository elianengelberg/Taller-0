{
  "name": "unify-escritorio",
  "productName": "Unify",
  "version": "1.7.0",
  "description": "Unify para Windows: detecta tus reuniones de Zoom, Microsoft Teams, Webex, Jitsi y más apps, y las graba con subtítulos, traducción e IA.",
  "main": "main.js",
  "author": {
    "name": "Unify",
    "url": "https://unify-meet.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unify.escritorio",
    "productName": "Unify",
    "files": [
      "main.js",
      "detector.js",
      "puente.js",
      "cartel.html",
      "preload-cartel.js",
      "extensionLocal.js",
      "grabador.html",
      "preload-grabador.js",
      "icono.png",
      "tienda.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Unify-Setup.exe",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "legalTrademarks": "Unify"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Unify",
      "uninstallDisplayName": "Unify",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elianengelberg",
        "repo": "Taller-0"
      }
    ],
    "copyright": "Copyright © 2026 Unify",
    "appx": {
      "applicationId": "Unify",
      "identityName": "Eluch.Unify-meet",
      "publisher": "CN=4B454654-01F8-48D4-9D39-E543404B77C5",
      "publisherDisplayName": "Eluch",
      "displayName": "Unify-meet",
      "backgroundColor": "#0f172a",
      "languages": [
        "es-AR",
        "es-ES",
        "en-US",
        "pt-BR"
      ],
      "showNameOnTiles": true,
      "customExtensionsPath": "build/appx-extensiones.xml",
      "artifactName": "Unify-Store.appx"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "yauzl": "^2.10.0"
  },
  "homepage": "https://unify-meet.com",
  "tienda": {
    "productId": "9P6WLSGRZB1Q"
  }
}
