{
  "name": "unify-escritorio",
  "productName": "Unify",
  "version": "1.4.0",
  "description": "Unify para Windows: detecta tus reuniones de Zoom y las graba con subtítulos, traducción e IA.",
  "main": "main.js",
  "author": "Unify",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unify.escritorio",
    "productName": "Unify",
    "files": [
      "main.js",
      "detector.js",
      "puente.js",
      "cartel.html",
      "preload-cartel.js",
      "extensionLocal.js",
      "grabador.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Unify-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elianengelberg",
        "repo": "Taller-0"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  }
}
