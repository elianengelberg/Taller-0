PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional: without these, the app still works for live meetings -- you just
# don't get permanent history, recordings, or the AI chat feature.

# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL=

# Cloudflare R2 (S3-compatible) bucket for storing meeting recordings.
# The browser uploads directly to the bucket, so it also needs a CORS policy
# (bucket Settings -> CORS Policy) allowing PUT/GET from your frontend's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (R2.dev subdomain or a connected custom domain)
R2_PUBLIC_URL=

# Google Sign-In (OAuth2). Create an OAuth client at
# console.cloud.google.com -> APIs & Services -> Credentials, application
# type "Web application". Without these three set, "Continuar con Google"
# simply doesn't show up on Login/Register (see /api/auth/config).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client, e.g.
# https://your-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Anthropic API key. Powers the "ask the AI about this meeting" feature, fast
# live-caption/chat translation via Claude instead of the slower free
# fallback, cleanup of speech-recognition mistakes in the transcript, and
# plain-language explanations of raw/cryptic errors shown in the UI.
ANTHROPIC_API_KEY=
# Optional: override the model used for meeting Q&A/reports (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=
# Optional: override the model used for live translation (defaults to claude-haiku-4-5)
ANTHROPIC_TRANSLATE_MODEL=
# Optional: override the model used to clean up transcript mishearings (defaults to claude-haiku-4-5)
ANTHROPIC_TRANSCRIPT_MODEL=
# Optional: override the model used to explain raw errors in plain language (defaults to claude-haiku-4-5)
ANTHROPIC_ERROR_MODEL=
