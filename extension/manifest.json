{
  "manifest_version": 3,
  "name": "Unify — asistente de reuniones",
  "version": "4.9.3",
  "description": "Subtítulos en vivo con traducción, transcripción y grabación de tus videollamadas, con un asistente de IA.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://taller-0.onrender.com/*",
    "http://localhost:4000/*",
    "http://localhost:4001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zoom.us/j/*",
        "https://*.zoom.us/w/*",
        "https://*.zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://meet.jit.si/*",
        "https://8x8.vc/*",
        "https://*.webex.com/*",
        "https://*.whereby.com/*",
        "https://gotomeet.me/*",
        "https://*.goto.com/*",
        "https://*.gotomeeting.com/*",
        "https://call.element.io/*",
        "https://join.skype.com/*",
        "https://*.skype.com/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://*.bluejeans.com/*",
        "https://*.chime.aws/*",
        "https://app.slack.com/*",
        "https://call.whatsapp.com/*",
        "https://*.zoho.com/*",
        "https://*.zohomeeting.com/*",
        "https://*.dialpad.com/*",
        "https://*.ringcentral.com/*",
        "https://*.livestorm.co/*",
        "https://*.gather.town/*"
      ],
      "js": [
        "prompt-injector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.unify-meet.com/*",
        "https://unify-meet.com/*",
        "https://taller-0.vercel.app/*",
        "http://localhost:4174/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "auth-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unify para Google Meet",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Empezar o detener la grabación de la reunión"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shadow.css",
        "offscreen.html"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
